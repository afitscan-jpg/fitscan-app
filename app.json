{
  "expo": {
    "name": "FitScan",
    "slug": "fitscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitscan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "FitScan uses your mic so you can just say what you ate.",
        "NSMicrophoneUsageDescription": "FitScan uses your mic so you can just say what you ate."
      },
      "bundleIdentifier": "com.sr8mu.fitscan"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.sr8mu.fitscan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FitScan uses the camera to scan product barcodes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FitScan uses your mic so you can just say what you ate.",
          "speechRecognitionPermission": "FitScan uses your mic so you can just say what you ate.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitScan uses your photos so you can add progress pictures. They stay on your device and are never uploaded.",
          "cameraPermission": "FitScan uses the camera so you can take progress photos. They stay on your device and are never uploaded."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0faf6b3-fe16-418f-b2bb-574686e9b282"
      }
    }
  }
}
